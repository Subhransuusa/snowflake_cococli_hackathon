# ============================================================
# SCM Analytics Platform - Deployment Configuration
# ============================================================
# Edit these values to match your Snowflake account before deploying.
# These are the ONLY values you need to change.
# ============================================================

# Snowflake database name (will be created if it doesn't exist)
SF_DATABASE=SCM_ANALYTICS

# Schema name within the database (will be created if it doesn't exist)
SF_SCHEMA=SCM

# Warehouse name (must already exist in your account)
SF_WAREHOUSE=COMPUTE_WH
